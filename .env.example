# Copy to .env in the repository root and fill in the values.
# Keep real credentials out of this example. Git ignores .env.

# Soniox API key. Backend only.
SONIOX_API_KEY=

# In Clerk, select your application and instance, then open API keys.
# Copy both keys from that page. The publishable key is safe for the frontend;
# the secret key must remain on the backend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# User allowed to administer rooms and sessions.
# In the same Clerk application and environment, open Users, select the user,
# and copy their User ID (starts with user_). If empty, administration stays closed.
ADMIN_USER_ID=

# Initial PostgreSQL database and credentials.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
