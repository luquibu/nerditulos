# Copy to .env in the repository root and fill in the values. Git ignores .env.
# Docker Compose reads this file to build the app container's environment (compose.yaml lists
# the variables that reach the container). A server run on the host reads .env.local instead;
# see docs/development.md.
#
# Quoting: put a value that contains $, spaces, or # in single quotes, for example
# POSTGRES_PASSWORD='x$y z'. Compose expands ${...} and $VAR inside unquoted and double-quoted
# values; Node's --env-file strips the quotes and never expands. Single quotes work in both.

# Public origin of this installation, without a path (scheme + host). Used to authorize the
# administrator's session tokens and the audio uplink; also the URL attendees open.
APP_ORIGIN=https://captions.example.org

# Event name shown in the rooms page heading and in browser tab titles. Optional.
EVENT_NAME=

# Soniox API key. Backend only.
SONIOX_API_KEY=
# Soniox real-time model. Optional, default stt-rt-v5.
SONIOX_MODEL=

# In Clerk, select your application and instance, then open API keys.
# Copy both keys from that page. The publishable key is safe for the frontend;
# the secret key must remain on the backend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# User allowed to administer rooms and sessions.
# In the same Clerk application and environment, open Users, select the user,
# and copy their User ID (starts with user_). If empty, administration stays closed.
ADMIN_USER_ID=

# Initial PostgreSQL database and credentials. The db service creates them on its first start;
# changing POSTGRES_PASSWORD later does not change the password stored in the volume.
# The app receives them as discrete PG* fields (PGUSER, PGPASSWORD, PGDATABASE).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Database TLS. compose.yaml connects to its own db service over the Compose network without TLS
# and does not pass these two variables. For an external database that requires TLS, set
# PGSSLMODE=require (read by node-postgres) and, for a private CA, NODE_EXTRA_CA_CERTS=<PEM file>
# (read by Node at start) where the server process runs: the platform's variables, .env.local for
# a host-run server, or the app service environment in compose.override.yaml. See README.md,
# "Production requirements".
# PGSSLMODE=require
# NODE_EXTRA_CA_CERTS=/certs/ca.pem

# Operational limits. Optional; defaults shown.
# Time allowed for pending provider output after a session finishes, in milliseconds.
DRAIN_TIMEOUT_MS=15000
# Segments kept in the public reading window per stream.
PUBLIC_WINDOW_SEGMENTS=20
# Final characters per segment before a new segment opens at the next word boundary.
SEGMENT_MAX_CHARS=400
